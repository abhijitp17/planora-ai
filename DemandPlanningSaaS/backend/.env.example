# Planora AI backend — environment configuration template.
#
# Copy to `.env` for local development (`.env` is gitignored — never commit real
# secrets). In production, set these as real environment variables.

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite is the zero-setup local default (used when DATABASE_URL is unset).
# For production, use a PostgreSQL URL, e.g.:
#   postgresql://dp_admin:dp_password@localhost:5432/demand_planning
DATABASE_URL=sqlite:///./demand_planning.db

# Connection pool sizing (ignored for SQLite).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ─── Authentication (used from Milestone 3 onward) ──────────────────────────
# REQUIRED in any environment that serves auth: there is NO default and the app
# will refuse to issue/verify tokens without it. Generate a strong value with:
#   openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (replaces the old wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Logging / Observability ────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "json" for structured logs (Datadog/ELK/CloudWatch); anything else = plain text.
LOG_FORMAT=text
